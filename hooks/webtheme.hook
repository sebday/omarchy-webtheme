#!/bin/bash
# Copy the active Omarchy theme CSS into the unpacked webtheme extension,
# then poke open Brave/Chromium tabs to reload it.

WEBTHEME="${HOME}/.config/omarchy/plugins/evo.webtheme/bin/webtheme"

if [[ -x $WEBTHEME ]]; then
  "$WEBTHEME" sync-theme >/dev/null
  exit 0
fi

THEME="${HOME}/.local/state/omarchy/current/theme"
EXT="${HOME}/.local/share/omarchy/webtheme/extension"

[[ -d $EXT ]] || exit 0

if [[ -f $THEME/colors.css ]]; then
  cp -f "$THEME/colors.css" "$EXT/colors.css"
fi
rm -f "$EXT/shoelace-hex.css"

date +%s >"$EXT/revision"
